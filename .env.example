# Da Vinci Studio — Environment Variables
# Copy this file to .env and fill in your values.
# PUBLIC_ prefix = exposed to the browser (safe for non-secret config).

# ──────────────────────────────────────────────────────
# Analytics — Umami (self-hosted, privacy-first)
# Leave blank to disable analytics entirely.
# ──────────────────────────────────────────────────────
PUBLIC_UMAMI_URL=
PUBLIC_UMAMI_SITE_ID=

# ──────────────────────────────────────────────────────
# Site configuration
# Used by Layout.astro for canonical URLs and OG images.
# ──────────────────────────────────────────────────────
# SITE_URL is baked into astro.config.mjs — only change there.

---
const projects = [
  { name: "Hölker Kitchens", url: "https://holkerkitchens.com", year: "2024", placeholder: "https://placehold.co/600x400?text=Hölker+Kitchens" },
  { name: "Meranti Kitchens", url: "https://merantikitchens.com", year: "2024", placeholder: "https://placehold.co/600x400?text=Meranti+Kitchens" },
  { name: "Bellezza Cucine", url: "https://bellezzacucine.com", year: "2023", placeholder: "https://placehold.co/600x400?text=Bellezza+Cucine" },
  { name: "Maestro Dental Lab", url: "https://maestrodentallab.com", year: "2023", placeholder: "https://placehold.co/600x400?text=Maestro+Dental+Lab" },
  { name: "ON Tech Group", url: "https://sajedm6.wixsite.com/website-3", year: "2022", placeholder: "https://placehold.co/600x400?text=ON+Tech+Group" },
  { name: "Kölman Kitchens", url: "https://sajedm6.wixsite.com/website-1", year: "2022", placeholder: "https://placehold.co/600x400?text=Kölman+Kitchens" }
];
---
<div class="portfolio-grid">
  {projects.map(project => (
    <a href={project.url} target="_blank" class="portfolio-item">
      <div class="portfolio-image">
        <img src={project.placeholder} alt={project.name} loading="lazy" />
        <div class="portfolio-overlay">
          <span class="portfolio-name">{project.name}</span>
          <span class="portfolio-year">{project.year}</span>
        </div>
      </div>
    </a>
  ))}
</div>

<style>
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }
  .portfolio-item {
    display: block;
    text-decoration: none;
    border-radius: 1rem;
    overflow: hidden;
    background: var(--bg2);
    transition: transform 0.3s ease;
  }
  .portfolio-item:hover {
    transform: scale(1.02);
  }
  .portfolio-image {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .portfolio-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .portfolio-item:hover img {
    transform: scale(1.05);
  }
  .portfolio-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
    padding: 1rem;
    text-align: center;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .portfolio-item:hover .portfolio-overlay {
    opacity: 1;
  }
  .portfolio-name {
    display: block;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.2rem;
    color: #fff;
  }
  .portfolio-year {
    font-size: 0.8rem;
    color: var(--accent);
  }
</style>
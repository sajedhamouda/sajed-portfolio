---
const milestones = [
  { year: "2020", title: "Started Freelancing", description: "Began web design journey, focusing on Wix and brand identity." },
  { year: "2022", title: "Wix Certified", description: "Earned Wix Certified Web Designer credential." },
  { year: "2023", title: "Accessibility Specialist", description: "Obtained Wix Accessibility Specialist certification — May 2023." },
  { year: "2024", title: "Da Vinci Studio", description: "Launched Da Vinci Studio, expanding to luxury kitchen and healthcare clients." },
];
---
<div class="timeline">
  {milestones.map((m, i) => (
    <div class="timeline-item">
      <div class="timeline-year">{m.year}</div>
      <div class="timeline-dot"></div>
      <div class="timeline-content">
        <h3>{m.title}</h3>
        <p>{m.description}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 0;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    background: #222222;
    transform: translateX(-50%);
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 1fr 40px 1fr;
    align-items: center;
    gap: 1rem;
    margin-bottom: 3rem;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .timeline-item.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .timeline-item:nth-child(even) .timeline-year { order: 3; text-align: left; }
  .timeline-item:nth-child(even) .timeline-content { order: 1; text-align: right; }
  .timeline-item:nth-child(even) .timeline-dot { order: 2; }
  .timeline-year {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    color: #e63030;
    text-align: right;
  }
  .timeline-dot {
    width: 12px;
    height: 12px;
    background: #e63030;
    border-radius: 50%;
    margin: 0 auto;
    flex-shrink: 0;
  }
  .timeline-content {
    background: #111111;
    border: 1px solid #222222;
    padding: 1rem 1.5rem;
  }
  .timeline-content h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.2rem;
    color: #f0ede6;
    margin-bottom: 0.4rem;
    letter-spacing: 0.04em;
  }
  .timeline-content p {
    font-family: 'Outfit', sans-serif;
    font-size: 0.82rem;
    color: #888888;
    line-height: 1.6;
  }
  @media (max-width: 768px) {
    .timeline::before { left: 16px; }
    .timeline-item {
      grid-template-columns: 32px 1fr;
      grid-template-rows: auto auto;
    }
    .timeline-year { grid-column: 2; order: 1 !important; text-align: left !important; font-size: 1.5rem; }
    .timeline-dot { grid-column: 1; grid-row: 1 / 3; order: 0 !important; margin: 0; }
    .timeline-content { grid-column: 2; order: 2 !important; text-align: left !important; }
  }
</style>

<script>
  (function() {
    function initTimeline() {
      const items = document.querySelectorAll('.timeline-item');
      if (!items.length) return;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            setTimeout(() => entry.target.classList.add('visible'), i * 100);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2 });
      items.forEach(item => observer.observe(item));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTimeline);
    } else {
      initTimeline();
    }
  })();
</script>

---
import '../styles/global.css';
import '../styles/case-study.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?:       string;
  description?: string;
  ogImage?:     string;
  canonical?:   string;
  noindex?:     boolean;
}

const SITE_URL = 'https://davincistudio.ae';

const {
  title       = 'Case Study — Da Vinci Studio Cinematic Portfolio',
  description = 'A detailed engineering and design case study of the Da Vinci Studio cinematic portfolio system. Architecture, performance, interaction design, and production methodology.',
  ogImage     = '/og/case-study.svg',
  canonical   = `${SITE_URL}/case-study`,
  noindex     = false,
} = Astro.props;

const fullOgImage = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author"      content="Sajed Hamouda" />
    <meta name="robots"      content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical"    href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type"        content="article" />
    <meta property="og:site_name"   content="Da Vinci Studio" />
    <meta property="og:url"         content={canonical} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={fullOgImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"   content={title} />
    <meta property="og:locale"      content="en_AE" />

    <!-- Twitter / X card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={fullOgImage} />
    <meta name="twitter:image:alt"   content={title} />

    <!-- Favicon -->
    <link rel="icon"             type="image/x-icon" href="/favicon.ico" />
    <link rel="icon"             type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.ico" />

    <!-- Fonts — non-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
    </noscript>

    <!-- Analytics (privacy-first, no-op when PUBLIC_UMAMI_URL not set) -->
    <Analytics />
  </head>
  <body class="cs-body">
    <a href="#main-content" class="cs-skip-link">Skip to main content</a>
    <slot />
  </body>
</html>

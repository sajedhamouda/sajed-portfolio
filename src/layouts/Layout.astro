---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sajed Hamouda — Wix Certified Web Designer & UI/UX Specialist. Founder of Da Vinci Studio, based in Abu Dhabi, UAE." />
    <meta name="author" content="Sajed Hamouda" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Load font CSS non-blocking: media=print swap trick keeps it render-safe -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <!-- Fallback for no-JS — same sheet, standard blocking -->
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
    </noscript>
    <title>Sajed Hamouda — Da Vinci Studio</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  :global(*), :global(*::before), :global(*::after) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  :global(html) {
    scroll-behavior: auto;
    overflow-x: hidden;
    height: 100%;
  }
  :global(body) {
    background: #000;
    color: #f0f0f0;
    font-family: 'Outfit', sans-serif;
    font-weight: 300;
    overflow-x: hidden;
    height: 100%;
    min-height: 100vh;
    min-height: 100dvh;
  }
</style>
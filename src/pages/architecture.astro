      <h3 class="cs-h3" style="margin-top:48px">Lazy-loading architecture</h3>

      <div class="cs-diagram">
        <div class="cs-diagram-label">React.lazy() split points — App.tsx</div>
        <pre>
<span class="dim">// Eager — needed before cinematic-entry</span>
<span class="hl">import</span> &#123; HeroScene &#125;     from './scenes/Hero/HeroScene'
<span class="hl">import</span> &#123; BootSystem &#125;    from './boot/BootSystem'

<span class="dim">// Lazy — deferred until cinematic-entry fires</span>
<span class="hl-v">const</span> PhilosophyScene = lazy(() =&gt; import('./scenes/Philosophy/PhilosophyScene'))
<span class="hl-v">const</span> ServicesScene   = lazy(() =&gt; import('./scenes/Services/ServicesScene'))

    <!-- ── 08 · Interaction Pipeline ─────────────────────────────────────────── -->
    <section class="cs-section">
      <div class="cs-section-eyeline">
        <span class="cs-section-num">08</span>
        <span class="cs-section-label">Interaction Pipeline</span>
      </div>

      <h2 class="cs-h2">From input to pixel</h2>

      <div class="cs-diagram">
        <div class="cs-diagram-label">Pointer interaction data flow</div>
        <pre>
mousemove event (window, passive)
    │
    ↓
<span class="hl">PointerEngine._raw</span> ← raw clientX/Y stored (no processing)
    │
    ↓ RAF tick (~60fps)
<span class="hl">PointerEngine._current</span> ← LERP(current, raw, 0.055 × dt/16.667)
    │
    ↓ subscribers notified if !reducedMotion && !coarsePointer
    │
    ├──→ <span class="hl-v">HeroScene</span>  usePointer()
    │        │ sceneIntensity('hero') → 1.0 if primary, 0.3 if secondary, 0.0 if inactive
    │        └→ firstRef.style.transform = translate(cx*8*i, cy*5*i)   ← 8px max
    │           lastRef.style.transform  = translate(cx*-5*i, cy*-3*i) ← depth illusion
    │           metaRef.style.transform  = translate(cx*2*i, cy*1.5*i) ← sub-identity
    │
    ├──→ <span class="hl-v">CTAScene</span>  usePointer()
    │        └→ primaryBtn.style.transform = translateY(cy*-3*i)       ← 3px max lift
    │
    └──→ <span class="hl-v">CursorField</span>  PointerEngine.subscribe()
             └→ innerDiv.style.transform = translate(x - vw/2, y - vh/2)
                                                                        ← gradient follows cursor
        </pre>
      </div>

      <div class="cs-diagram" style="margin-top: 24px;">
        <div class="cs-diagram-label">Scroll to scene-state data flow</div>
        <pre>
Lenis RAF tick
    │
    └→ ScrollEngine callback ← lenis.on('scroll', ...)
           │
           ↓
    <span class="hl">SceneController.update(progress)</span>  ← normalised 0–1
           │
           ↓ for each of 6 registered scenes:
    calculateSceneState(scene, progress)
           │
           ├── progress &lt; start - 0.05 OR &gt; end + 0.05  → <span class="dim">inactive</span>
           ├── progress within [start, end]               → <span class="hl">primary</span>
           └── otherwise                                  → <span class="hl-v">secondary</span>
           │
           ↓ on state change only:
    scene.onStateChange(newState)  ← triggers SceneWrapper re-render
    SceneController.listeners      ← notified every frame (DepthLayer, HeroSignature)
        </pre>
      </div>
    </section>


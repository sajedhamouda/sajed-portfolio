  <!-- FOOTER -->
  <footer>
    <div class="footer-top">
      <div class="footer-brand">DA VINCI <span>STUDIO</span> · Sajed Hamouda</div>
      <ul class="footer-nav">
        <li><a href="#stats">About</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#work">Work</a></li>
        <li><a href="#timeline">Journey</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
    <div class="footer-bottom">
      <span class="footer-copy">© 2026 Sajed Hamouda · All Rights Reserved</span>
      <a href="tel:+971547474328" class="footer-phone">+971 54 747 4328</a>
      <a href="https://www.linkedin.com/in/m-sajed-hamouda" target="_blank" class="footer-li" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>

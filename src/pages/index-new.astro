  <script>
    (function() {
      function init() {
        // CURSOR
        const dot  = document.getElementById('dot');
        const ring = document.getElementById('ring');
        let mx=0, my=0, rx=0, ry=0;
        if (dot && ring) {
          document.addEventListener('mousemove', e => {
            mx = e.clientX; my = e.clientY;
            dot.style.left = mx + 'px';
            dot.style.top  = my + 'px';
          });
          (function anim() {
            rx += (mx - rx) * 0.11;
            ry += (my - ry) * 0.11;
            ring.style.left = rx + 'px';
            ring.style.top  = ry + 'px';
            requestAnimationFrame(anim);
          })();
          document.querySelectorAll('a, button').forEach(el => {
            el.addEventListener('mouseenter', () => ring.classList.add('big'));
            el.addEventListener('mouseleave', () => ring.classList.remove('big'));
          });
        }

        // SCROLL PROGRESS
        const prog = document.getElementById('scroll-progress');
        if (prog) {
          window.addEventListener('scroll', () => {
            const pct = (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100;
            prog.style.width = pct + '%';
          }, { passive: true });
        }

        // ACTIVE NAV
        const navLinks = document.querySelectorAll('.nav-links a');
        const sectionIds = ['stats','services','work','timeline','contact'];
        window.addEventListener('scroll', () => {
          let current = '';
          sectionIds.forEach(id => {
            const el = document.getElementById(id);
            if (el && window.scrollY >= el.offsetTop - 120) current = id;
          });
          navLinks.forEach(a => {
            a.classList.toggle('active', a.getAttribute('href') === '#' + current);
          });
        }, { passive: true });

        // TYPEWRITER
        const phrases = ['Wix websites.','UI/UX experiences.','multilingual sites.','digital certificates.','luxury brand presence.','logo identities.'];
        const twEl = document.getElementById('tw-text');
        if (twEl) {
          let idx=0, ch=0, del=false;
          function type() {
            if (!twEl) return;
            const cur = phrases[idx];
            if (!del) {
              twEl.textContent = cur.slice(0, ++ch);
              if (ch === cur.length) { del = true; setTimeout(type, 1800); return; }
              setTimeout(type, 65);
            } else {
              twEl.textContent = cur.slice(0, --ch);
              if (ch === 0) { del = false; idx = (idx+1) % phrases.length; setTimeout(type, 400); return; }
              setTimeout(type, 35);
            }
          }
          setTimeout(type, 1800);
        }

        // REVEAL ON SCROLL
        const reveals = document.querySelectorAll('.reveal');
        const ro = new IntersectionObserver(entries => {
          entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); } });
        }, { threshold: 0.1 });
        reveals.forEach(r => ro.observe(r));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>

</Layout>

<style>
  /* SCROLL PROGRESS */
  #scroll-progress {
    position: fixed;
    top: 0; left: 0;
    width: 0%;
    height: 3px;
    background: #e63030;
    z-index: 9999;
    transition: width 0.1s linear;
  }

  /* NAV */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 500;
    background: rgba(10,10,10,0.95);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 56px;
    border-bottom: 1px solid #222222;
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    letter-spacing: 0.1em;
    color: #e63030;
    text-decoration: none;
  }
  .nav-links {
    display: flex;
    gap: 36px;
    list-style: none;
  }
  .nav-links a {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #888888;
    text-decoration: none;
    position: relative;
    padding-bottom: 3px;
    transition: color 0.25s;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 0; height: 1.5px;
    background: #e63030;
    transition: width 0.3s ease;
  }
  .nav-links a:hover::after,
  .nav-links a.active::after { width: 100%; }
  .nav-links a:hover,
  .nav-links a.active { color: #e63030; }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .nav-linkedin {
    color: #888888;
    transition: color 0.25s;
    display: flex;
    align-items: center;
  }
  .nav-linkedin:hover { color: #e63030; }
  .nav-contact {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #0a0a0a;
    background: #f0ede6;
    text-decoration: none;
    padding: 10px 24px;
    transition: background 0.25s;
  }
  .nav-contact:hover { background: #e63030; color: #f0ede6; }

  /* HERO */
  #hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 100px 56px 80px;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
  }
  .hero-tag {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #e63030;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUp 0.7s ease forwards 0.3s;
  }
  .hero-tag::before {
    content: '';
    width: 32px;
    height: 2px;
    background: #e63030;
    flex-shrink: 0;
  }
  .hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(5rem, 16vw, 16rem);
    line-height: 0.88;
    letter-spacing: 0.01em;
    color: #f0ede6;
    opacity: 0;
    animation: fadeUp 1s ease forwards 0.5s;
  }
  .line2 { display: block; }
  .hero-sub {
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #888888;
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 16px;
    opacity: 0;
    animation: fadeUp 1s ease forwards 0.7s;
  }
  .hero-sub::before {
    content: '';
    width: 32px;
    height: 1px;
    background: #333333;
    flex-shrink: 0;
  }
  .available-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #2db358;
    background: #0d2b1a;
    border: 1px solid #1a5c35;
    padding: 6px 14px;
    margin-top: 16px;
    opacity: 0;
    animation: fadeUp 1s ease forwards 0.85s;
    width: fit-content;
  }
  .available-dot {
    width: 7px;
    height: 7px;
    background: #2db358;
    border-radius: 50%;
    animation: pulse-green 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes pulse-green {
    0%,100% { box-shadow: 0 0 0 0 rgba(45,179,88,0.4); }
    50% { box-shadow: 0 0 0 5px rgba(45,179,88,0); }
  }
  .typewriter-wrap {
    font-size: 0.9rem;
    font-weight: 400;
    color: #888888;
    letter-spacing: 0.05em;
    min-height: 1.4em;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 24px;
    opacity: 0;
    animation: fadeIn 0.5s ease forwards 1.4s;
  }
  .tw-text { color: #e63030; font-weight: 500; }
  .tw-cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: #e63030;
    animation: blink 0.75s step-end infinite;
    vertical-align: middle;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
  .hero-desc {
    max-width: 480px;
    font-size: 0.9rem;
    line-height: 1.85;
    color: #888888;
    margin-top: 2rem;
    opacity: 0;
    animation: fadeUp 1s ease forwards 0.9s;
  }

  /* TICKER */
  .ticker-wrap {
    overflow: hidden;
    padding: 16px 0;
    background: #f0ede6;
    border-top: 2px solid #e63030;
  }
  .ticker-track {
    display: flex;
    animation: ticker 30s linear infinite;
    white-space: nowrap;
  }
  .ticker-item {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.95rem;
    letter-spacing: 0.18em;
    color: #0a0a0a;
    padding: 0 32px;
    display: inline-flex;
    align-items: center;
    gap: 32px;
  }
  .ticker-item .dot {
    width: 5px;
    height: 5px;
    background: #e63030;
    border-radius: 50%;
    display: inline-block;
    flex-shrink: 0;
  }
  @keyframes ticker {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* SECTIONS */
  .section-pad {
    padding: 120px 56px;
    position: relative;
  }
  .section-bg-num {
    position: absolute;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(8rem, 20vw, 18rem);
    color: rgba(255,255,255,0.03);
    line-height: 1;
    top: 40px;
    right: 40px;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .section-eyebrow {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #e63030;
    margin-bottom: 48px;
    position: relative;
    z-index: 1;
  }
  .section-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: 0.02em;
    color: #f0ede6;
    margin-bottom: 3rem;
    position: relative;
    z-index: 1;
  }
  .section-title span { color: #e63030; }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* REVEAL */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.85s ease, transform 0.85s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: none;
  }

  /* CONTACT */
  #contact { position: relative; }
  .contact-eyebrow {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #e63030;
    margin-bottom: 48px;
  }
  .contact-big {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3.5rem, 10vw, 10rem);
    line-height: 0.9;
    color: #f0ede6;
    margin-bottom: 64px;
  }
  .contact-big span { color: #e63030; }
  .contact-row {
    display: flex;
    align-items: center;
    gap: 40px;
    flex-wrap: wrap;
    padding-top: 48px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .contact-email {
    font-family: 'Bebas Neue', sans-serif;

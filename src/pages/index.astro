---
import Layout from '../layouts/Layout.astro';
---

<Layout>

  <!-- NAV -->
  <nav>
    <a href="#" class="nav-logo">SH</a>
    <ul class="nav-links">
      <li><a href="#about">About</a></li>
      <li><a href="#services">Services</a></li>
      <li><a href="#work">Work</a></li>
      <li><a href="#logos">Logos</a></li>
    </ul>
    <div class="nav-right">
      <a href="https://www.linkedin.com/in/m-sajed-hamouda" target="_blank" class="nav-linkedin">in</a>
      <a href="mailto:sajedhamouda@gmail.com" class="nav-contact">Contact me</a>
    </div>
  </nav>
<!-- HERO -->
  <section id="hero">
    <div class="hero-tag">Wix Certified Designer &amp; UI/UX Specialist</div>
    <div class="hero-name">
      <h1>SAJED<span class="line2">HAMOUDA</span></h1>
      <p class="subtitle">Founder, Da Vinci Studio &nbsp;·&nbsp; Abu Dhabi, UAE</p>
      <div class="available-badge">
        <span class="available-dot"></span>Available for new projects
      </div>
    </div>
    <div class="typewriter-wrap">
      I build&nbsp;<span class="tw-text" id="tw-text"></span><span class="tw-cursor"></span>
    </div>
    <div class="hero-bottom">
      <p class="hero-desc">Professional Wix website designer crafting high-performance digital experiences for luxury brands, kitchens, and healthcare — based in the United Arab Emirates.</p>
      <div class="hero-location">
        <strong>United Arab Emirates</strong>Based in UAE · Available Worldwide
      </div>
    </div>
  </section>
  <script>
    const phrases = ['Wix websites.','UI/UX experiences.','multilingual sites.','digital certificates.','luxury brand presence.','logo identities.'];
    const twEl = document.getElementById('tw-text');
    let idx=0,ch=0,del=false;
    function type() {
      const cur = phrases[idx];
      if (!del) {
        twEl.textContent = cur.slice(0,++ch);
        if (ch===cur.length) { del=true; setTimeout(type,1800); return; }
        setTimeout(type,65);
      } else {
        twEl.textContent = cur.slice(0,--ch);
        if (ch===0) { del=false; idx=(idx+1)%phrases.length; setTimeout(type,400); return; }
        setTimeout(type,35);
      }
    }
    setTimeout(type, 1600);
  </script>
</Layout>

<style>
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 500;
    background: #0a0a0a;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 56px;
    border-bottom: 1px solid #222222;
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    letter-spacing: 0.1em;
    color: #e63030;
    text-decoration: none;
  }
  .nav-links {
    display: flex;
    gap: 36px;
    list-style: none;
  }
  .nav-links a {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #888888;
    text-decoration: none;
    position: relative;
    padding-bottom: 3px;
    transition: color 0.25s;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 0; height: 1.5px;
    background: #e63030;
    transition: width 0.3s ease;
  }
  .nav-links a:hover::after { width: 100%; }
  .nav-links a:hover { color: #e63030; }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .nav-linkedin {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #888888;
    text-decoration: none;
    transition: color 0.25s;
  }
  .nav-linkedin:hover { color: #e63030; }
  .nav-contact {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #0a0a0a;
    background: #f0ede6;
    text-decoration: none;
    padding: 10px 24px;
    transition: background 0.25s;
  }
  .nav-contact:hover { background: #e63030; color: #f0ede6; }
  #hero {
    min-height: 100vh;
    padding: 120px 56px 80px;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr auto;
    position: relative;
    overflow: hidden;
  }
  .hero-tag {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #e63030;
    margin-bottom: 20px;
    opacity: 0;
    animation: fadeUp 0.7s ease forwards 0.3s;
  }
  .hero-tag::before {
    content: '';
    width: 32px;
    height: 2px;
    background: #e63030;
  }
  .hero-name {
    grid-column: 1 / -1;
    grid-row: 2;
    align-self: center;
  }
  .hero-name h1 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(5rem, 18vw, 18rem);
    line-height: 0.88;
    letter-spacing: 0.01em;
    color: #f0ede6;
    opacity: 0;
    animation: fadeUp 1s ease forwards 0.5s;
  }
  .line2 { display: block; }
  .subtitle {
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #888888;
    margin-top: 8px;
    display: flex;
    align-items: center;
    gap: 20px;
    opacity: 0;
    animation: fadeUp 1s ease forwards 0.7s;
  }
  .subtitle::before {
    content: '';
    width: 40px;
    height: 1px;
    background: #333333;
  }
  .available-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #2db358;
    background: #0d2b1a;
    border: 1px solid #1a5c35;
    padding: 6px 14px;
    border-radius: 2px;
    margin-top: 16px;
    opacity: 0;
    animation: fadeUp 1s ease forwards 0.85s;
    width: fit-content;
  }
  .available-dot {
    width: 7px;
    height: 7px;
    background: #2db358;
    border-radius: 50%;
    animation: pulse-green 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes pulse-green {
    0%,100% { box-shadow: 0 0 0 0 rgba(45,179,88,0.4); }
    50% { box-shadow: 0 0 0 5px rgba(45,179,88,0); }
  }
  .typewriter-wrap {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    font-size: 0.82rem;
    font-weight: 400;
    color: #888888;
    letter-spacing: 0.05em;
    min-height: 1.4em;
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
    opacity: 0;
    animation: fadeIn 0.5s ease forwards 1.4s;
  }
  .tw-text { color: #e63030; font-weight: 500; }
  .tw-cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: #e63030;
    animation: blink 0.75s step-end infinite;
    vertical-align: middle;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
  .hero-bottom {
    grid-column: 1 / -1;
    grid-row: 3;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 60px;
    opacity: 0;
    animation: fadeUp 1s ease forwards 0.9s;
  }
  .hero-desc {
    max-width: 420px;
    font-size: 0.95rem;
    line-height: 1.85;
    color: #888888;
  }
  .hero-location {
    text-align: right;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #888888;
  }
  .hero-location strong {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: #f0ede6;
    letter-spacing: 0.05em;
    text-transform: none;
    margin-bottom: 4px;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes fadeIn { to { opacity: 1; } }
</style>